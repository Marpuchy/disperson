{% extends 'base.html.twig' %}

{% block title %}Perfil de Usuario{% endblock %}

{% block content %}
    {% block javascripts %}
        <script src="{{ asset('js/stats.js') }}"></script>
        <script src="{{ asset('js/description.js') }}"></script>
        <script>
            window.userStats = {
                experiencia: {{ experiencia }},
                responsabilidad: {{ responsabilidad }},
                extraversion: {{ extraversion }},
                amabilidad: {{ amabilidad }},
                emocional: {{ emocional }}
            };
        </script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

        <script>
            $(document).ready(function () {
                $("#jquery-accordion").accordion({
                    heightStyle: "content",
                    collapsible: true
                });
            });
        </script>
        <script>
            $(document).ready(function(){
                $("#btnVolver").click(function(){
                    window.history.back();
                });
            });
        </script>
    {% endblock %}
    <link href="{{ asset('css/profile.css') }}" rel="stylesheet">

    <div class="container my-5 custom-width">
        <h1 class="text-center mb-4">Perfil de Usuario</h1>

        <!-- Botón de Volver al Inicio -->
        <a href="#" class="btn btn-primary mb-3" id="btnVolver">Volver Atrás</a>

        <!-- Fila para las dos columnas: estadísticas a la izquierda y gráfico a la derecha -->
        <div class="row customRow">
            <!-- Accordion para las estadísticas -->
            <div class="col-md-6 mb-4">
                <div id="jquery-accordion" class="custom-accordion">
                    <h3 class="accordion-button firstElement">Apertura a la Experiencia</h3>
                    <div class="custom-accordion-body">
                        <h5 class="card-title">Apertura a la experiencia: {{ experiencia }}</h5>
                        <div class="usercard">
                            <div class="usercard-body">
                                <div id="characterContainer">
                                    <h2>Tu personaje es: {{ experienciaCharacter.name }}</h2>
                                    <p>{{ experienciaCharacter.description }}</p>
                                </div>
                                <img src="{{ asset('resources/characters/' ~ experienciaCharacter.id ~ '.jpg') }}" alt="Character Image" class="characterImage">
                            </div>
                            <div id="descriptionExperiencia" class="descriptions"></div>
                        </div>
                    </div>

                    <h3 class="accordion-button">Responsabilidad</h3>
                    <div class="custom-accordion-body">
                        <h5 class="card-title">Responsabilidad: {{ responsabilidad }}</h5>
                        <div class="usercard">
                            <div class="usercard-body">
                                <div id="characterContainer">
                                    <h2>Tu personaje es: {{ responsabilidadCharacter.name }}</h2>
                                    <p>{{ responsabilidadCharacter.description }}</p>
                                </div>
                                <img src="{{ asset('resources/characters/' ~ responsabilidadCharacter.id ~ '.jpg') }}" alt="Character Image" class="characterImage">
                            </div>
                            <div id="descriptionResponsabilidad" class="descriptions"></div>
                        </div>
                    </div>

                    <h3 class="accordion-button">Extraversión</h3>
                    <div class="custom-accordion-body">
                        <h5 class="card-title">Extraversión: {{ extraversion }}</h5>
                        <div class="usercard">
                            <div class="usercard-body">
                                <div id="characterContainer">
                                    <h2>Tu personaje es: {{ extraversionCharacter.name }}</h2>
                                    <p>{{ extraversionCharacter.description }}</p>
                                </div>
                                <img src="{{ asset('resources/characters/' ~ extraversionCharacter.id ~ '.jpg') }}" alt="Character Image" class="characterImage">
                            </div>
                            <div id="descriptionExtraversion" class="descriptions"></div>
                        </div>
                    </div>

                    <h3 class="accordion-button">Amabilidad</h3>
                    <div class="custom-accordion-body">
                        <h5 class="card-title">Amabilidad: {{ amabilidad }}</h5>
                        <div class="usercard">
                            <div class="usercard-body">
                                <div id="characterContainer">
                                    <h2>Tu personaje es: {{ amabilidadCharacter.name }}</h2>
                                    <p>{{ amabilidadCharacter.description }}</p>
                                </div>
                                <img src="{{ asset('resources/characters/' ~ amabilidadCharacter.id ~ '.jpg') }}" alt="Character Image" class="characterImage">
                            </div>
                            <div id="descriptionAmabilidad" class="descriptions"></div>
                        </div>
                    </div>

                    <h3 class="accordion-button">Estabilidad emocional</h3>
                    <div class="custom-accordion-body">
                        <h5 class="card-title">Estabilidad emocional: {{ emocional }}</h5>
                        <div class="usercard">
                            <div class="usercard-body">
                                <div id="characterContainer">
                                    <h2>Tu personaje es: {{ emocionalCharacter.name }}</h2>
                                    <p>{{ emocionalCharacter.description }}</p>
                                </div>
                                <img src="{{ asset('resources/characters/' ~ emocionalCharacter.id ~ '.jpg') }}" alt="Character Image" class="characterImage">
                            </div>
                            <div id="descriptionEmocional" class="descriptions"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gráfico pentágono a la derecha -->
            <div class="col-md-6 mb-4">
                <div class="pentagono mb-5">
                    <div id="canvas-container" class="my-4"></div>
                </div>
            </div>
        </div>

        <!-- Botón de cerrar sesión -->
        <form method="post" action="{{ path('app_logout') }}">
            <button type="submit" class="btn btn-danger w-100 mt-5">Cerrar Sesión</button>
        </form>
    </div>
{% endblock %}