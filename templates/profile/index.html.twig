{% extends 'base.html.twig' %}

{% block title %}Disperson | Perfil{% endblock %}
{% block body_class %}page-profile{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/profile.css') }}">
{% endblock %}

{% block javascripts %}
    <script>
        window.profileTraits = {{ traits|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }};
    </script>
    <script src="{{ asset('js/pages/profile.js') }}"></script>
{% endblock %}

{% block content %}
    <section class="profile-shell">
        <div class="profile-spotlight" data-reveal>
            <div class="profile-spotlight__copy">
                <span class="section-tag">Resultado principal</span>
                {% if featured_trait %}
                    <h1>{{ user.username }}, tu lectura dominante apunta a {{ featured_trait.label|lower }}.</h1>
                    <p>
                        Tu perfil combina puntuaciones del modelo Big Five con una lectura visual. El rasgo que primero define tu resultado es
                        <strong>{{ featured_trait.label }}</strong>, con {{ featured_trait.score }}/100 y un nivel {{ featured_trait.level }}.
                    </p>
                {% else %}
                    <h1>{{ user.username }}, ya tienes tu mapa de personalidad listo.</h1>
                    <p>
                        Tu perfil mezcla puntuaciones del modelo Big Five, niveles interpretados y personajes asociados. La base psicológica sigue siendo el
                        centro; la capa Disney aporta memoria visual y una lectura más cercana.
                    </p>
                {% endif %}

                <div class="profile-spotlight__stats">
                    {% if featured_trait %}
                        <article class="profile-kpi">
                            <span class="profile-kpi__label">Rasgo dominante</span>
                            <strong>{{ featured_trait.navigation_label }}</strong>
                        </article>
                        <article class="profile-kpi">
                            <span class="profile-kpi__label">Puntuación</span>
                            <strong>{{ featured_trait.score }}/100</strong>
                        </article>
                        <article class="profile-kpi">
                            <span class="profile-kpi__label">Nivel</span>
                            <strong>{{ featured_trait.level }}</strong>
                        </article>
                    {% endif %}
                </div>

                <div class="profile-hero__actions">
                    <a href="{{ path('app_quiz_start') }}" class="btn btn-outline-primary site-btn site-btn--ghost">Repetir test</a>
                    <a href="{{ path('app_about') }}" class="btn btn-primary site-btn">Ver modelo OCEAN</a>
                </div>
            </div>

            <aside class="profile-spotlight-card">
                {% if featured_trait and featured_trait.character %}
                    <div class="profile-spotlight-card__media">
                        <img
                            src="{{ asset('resources/characters/' ~ featured_trait.character.id ~ '.jpg') }}"
                            alt="{{ featured_trait.character.name }}"
                            width="380"
                            height="380"
                            decoding="async"
                            fetchpriority="high"
                        >
                    </div>
                    <div class="profile-spotlight-card__body">
                        <p class="profile-character__eyebrow">Personaje asociado</p>
                        <h2>{{ featured_trait.character.name }}</h2>
                        <p>{{ featured_trait.character.description }}</p>

                        <div class="profile-spotlight-card__meta">
                            <span>{{ featured_trait.ocean_letter }} · {{ featured_trait.label }}</span>
                            <span>Nivel {{ featured_trait.level }}</span>
                        </div>
                    </div>
                {% elseif featured_trait %}
                    <div class="profile-spotlight-card__body profile-spotlight-card__body--empty">
                        <p class="profile-character__eyebrow">Lectura principal</p>
                        <h2>{{ featured_trait.label }}</h2>
                        <p>{{ featured_trait.description }}</p>
                        <div class="profile-spotlight-card__meta">
                            <span>{{ featured_trait.score }}/100</span>
                            <span>Nivel {{ featured_trait.level }}</span>
                        </div>
                    </div>
                {% endif %}
            </aside>
        </div>

        <div class="profile-layout">
            <section class="profile-chart-card" data-reveal>
                <div class="profile-chart-card__header">
                    <span class="section-tag">Resumen visual</span>
                    <h2>Radar de personalidad</h2>
                    <p>Una vista rápida de cómo se reparten tus cinco dimensiones principales.</p>
                </div>

                <canvas id="profileChart" width="520" height="520" aria-label="Gráfico radar de rasgos"></canvas>

                <div class="profile-chart-card__legend" aria-label="Leyenda de rasgos">
                    {% for trait in traits %}
                        <span class="profile-chart-card__legend-item profile-chart-card__legend-item--{{ loop.index }}">
                            <span class="profile-chart-card__legend-dot"></span>
                            {{ trait.navigation_label }}
                        </span>
                    {% endfor %}
                </div>
            </section>

            <section class="profile-summary-grid">
                {% for trait in traits %}
                    {% include '_components/trait_metric.html.twig' with { trait: trait } %}
                {% endfor %}
            </section>
        </div>

        <section class="profile-details">
            <div class="section-heading" data-reveal>
                <span class="section-tag">Detalle</span>
                <h2>Interpretación por rasgo</h2>
                <p>Abre cada bloque para ver el nivel, el espectro del rasgo y el personaje que acompaña la lectura de tu resultado.</p>
            </div>

            <div class="profile-panel-list">
                {% for trait in traits %}
                    {% include '_components/profile_trait_panel.html.twig' with { trait: trait } %}
                {% endfor %}
            </div>
        </section>

        <form method="post" action="{{ path('app_logout') }}" class="profile-logout" data-reveal>
            <button type="submit" class="btn btn-outline-primary site-btn site-btn--ghost">Cerrar sesión</button>
        </form>
    </section>
{% endblock %}
