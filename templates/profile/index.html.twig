{% extends 'base.html.twig' %}

{% block title %}Disperson | Perfil{% endblock %}
{% block body_class %}page-profile{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/profile.css') }}">
{% endblock %}

{% block javascripts %}
    {% set initial_trait = featured_trait ?? traits|first %}
    <script>
        window.profileConfig = {
            traits: {{ traits|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }},
            activeTraitKey: {{ (initial_trait ? initial_trait.key : null)|json_encode|raw }},
            characterBasePath: {{ asset('resources/characters')|json_encode|raw }}
        };
    </script>
    <script src="{{ asset('js/pages/profile.js') }}"></script>
{% endblock %}

{% block content %}
    {% set initial_trait = featured_trait ?? traits|first %}
    {% set mapped_characters = 0 %}
    {% for trait in traits %}
        {% if trait.character %}
            {% set mapped_characters = mapped_characters + 1 %}
        {% endif %}
    {% endfor %}

    <section class="profile-shell" data-profile-root>
        <header class="profile-intro" data-reveal>
            <span class="section-tag">Mapa de personalidad</span>
            {% if initial_trait %}
                <h1>{{ user.username }}, este es tu mapa OCEAN.</h1>
                <p>
                    El pentagono central concentra tus cinco dimensiones y la lectura del rasgo activo se interpreta en una unica columna de datos.
                    Tu rasgo dominante ahora es <strong>{{ initial_trait.label }}</strong>, con {{ initial_trait.score }}/100 y nivel {{ initial_trait.level }}.
                </p>
            {% else %}
                <h1>{{ user.username }}, tu perfil ya esta listo para explorarse.</h1>
                <p>
                    El radar central resume tu resultado y cada rasgo activa una lectura contextual con descripcion, espectro y personaje asociado.
                </p>
            {% endif %}

            <div class="profile-intro__meta">
                <span>Dominante: {{ initial_trait ? initial_trait.navigation_label : 'Pendiente' }}</span>
                <span>{{ mapped_characters }}/{{ traits|length }} equivalencias visuales</span>
                <span>{{ traits|length }} dimensiones OCEAN</span>
            </div>

            <div class="profile-intro__actions">
                <a href="{{ path('app_quiz_start') }}" class="btn btn-outline-primary site-btn site-btn--ghost">Repetir test</a>
                <a href="{{ path('app_about') }}" class="btn btn-primary site-btn">Ver modelo OCEAN</a>
            </div>
        </header>

        <div class="profile-focus">
            <section class="profile-map-card" data-reveal>
                <div class="profile-map-card__header">
                    <span class="section-tag">Radar OCEAN</span>
                    <p>Pasa el cursor por el radar o usa la leyenda para cambiar el rasgo activo.</p>
                </div>

                <div class="profile-map-card__canvas-shell" data-profile-canvas-shell>
                    <canvas id="profileChart" width="640" height="640" aria-label="Grafico radar de rasgos"></canvas>
                </div>

                <div class="profile-map-card__legend" aria-label="Leyenda interactiva de rasgos">
                    {% for trait in traits %}
                        <button
                            type="button"
                            class="profile-map-card__legend-item {% if initial_trait and trait.key == initial_trait.key %}is-active{% endif %}"
                            data-profile-trait-button
                            data-profile-trait-key="{{ trait.key }}"
                            aria-pressed="{{ initial_trait and trait.key == initial_trait.key ? 'true' : 'false' }}"
                        >
                            <span class="profile-map-card__legend-dot profile-map-card__legend-dot--{{ loop.index }}"></span>
                            <span>{{ trait.navigation_label }}</span>
                        </button>
                    {% endfor %}
                </div>
            </section>

            <aside class="profile-active-panel" data-profile-active-panel data-reveal>
                <div class="profile-active-panel__header">
                    <p class="profile-active-panel__eyebrow" data-profile-active-eyebrow>
                        {{ initial_trait ? initial_trait.ocean_letter ~ ' / ' ~ initial_trait.navigation_label : '' }}
                    </p>
                    <h2 data-profile-active-label>{{ initial_trait ? initial_trait.label : 'Perfil listo' }}</h2>
                    <p class="profile-active-panel__summary" data-profile-active-summary>
                        {{ initial_trait ? initial_trait.summary : 'Selecciona un rasgo para ver la lectura asociada.' }}
                    </p>
                    <p data-profile-active-description>
                        {{ initial_trait ? initial_trait.description : 'Selecciona un rasgo para ver su lectura contextual.' }}
                    </p>
                </div>

                <div class="profile-active-panel__metrics">
                    <article>
                        <span>Puntuacion</span>
                        <strong data-profile-active-score>{{ initial_trait ? initial_trait.score ~ '/100' : '--' }}</strong>
                    </article>
                    <article>
                        <span>Nivel</span>
                        <strong data-profile-active-level>{{ initial_trait ? 'Nivel ' ~ initial_trait.level : '--' }}</strong>
                    </article>
                </div>

                <div class="profile-active-panel__spectrum">
                    <div class="profile-active-panel__scale" aria-hidden="true">
                        <span data-profile-active-scale style="width: {{ initial_trait ? initial_trait.score : 0 }}%"></span>
                    </div>
                    <div class="profile-active-panel__anchors">
                        <span data-profile-active-low>{{ initial_trait ? initial_trait.low_anchor : '' }}</span>
                        <span data-profile-active-high>{{ initial_trait ? initial_trait.high_anchor : '' }}</span>
                    </div>
                </div>

                <div class="profile-character-card {% if not initial_trait or not initial_trait.character %}is-empty{% endif %}" data-profile-character-card>
                    <div class="profile-character-card__media" data-profile-character-media {% if not initial_trait or not initial_trait.character %}hidden{% endif %}>
                        <img
                            data-profile-character-image
                            src="{{ initial_trait and initial_trait.character ? asset('resources/characters/' ~ initial_trait.character.id ~ '.jpg') : '' }}"
                            alt="{{ initial_trait and initial_trait.character ? initial_trait.character.name : '' }}"
                            loading="lazy"
                            decoding="async"
                        >
                    </div>

                    <div class="profile-character-card__copy">
                        <p class="profile-character__eyebrow">Personaje asociado</p>
                        <h3 data-profile-character-name>
                            {{ initial_trait and initial_trait.character ? initial_trait.character.name : 'Equivalencia visual pendiente' }}
                        </h3>
                        <p data-profile-character-description>
                            {{ initial_trait and initial_trait.character ? initial_trait.character.description : 'Todavia no hay personaje asociado para este nivel. La lectura psicologica sigue siendo valida y la equivalencia visual puede completarse desde el panel admin.' }}
                        </p>
                    </div>
                </div>
            </aside>
        </div>

        <form method="post" action="{{ path('app_logout') }}" class="profile-logout" data-reveal>
            <button type="submit" class="btn btn-outline-primary site-btn site-btn--ghost">Cerrar sesion</button>
        </form>
    </section>
{% endblock %}
