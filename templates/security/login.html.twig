{% extends 'base.html.twig' %}

{% block title %}Disperson | Entrar{% endblock %}
{% block body_class %}page-auth{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/auth.css') }}">
{% endblock %}

{% block content %}
    <section class="auth-shell">
        <div class="auth-panel auth-panel--copy" data-reveal>
            <span class="section-tag">Acceso</span>
            <h1>Vuelve a tu perfil.</h1>
            <p>
                Accede para continuar el cuestionario, revisar tus resultados o gestionar el contenido si eres administrador.
            </p>
            <div class="auth-note">
                <strong>Cuenta demo</strong>
                <span>`prueba@prueba.com` / `prueba`</span>
            </div>
        </div>

        <div class="auth-panel" data-reveal>
            <form method="post" class="auth-form">
                {% if error %}
                    <div class="flash flash--danger">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <div class="form-field">
                    <label for="inputEmail">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" autocomplete="email" required autofocus>
                </div>

                <div class="form-field">
                    <label for="inputPassword">Contraseña</label>
                    <input type="password" name="password" id="inputPassword" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary site-btn w-100" type="submit">Entrar</button>

                <p class="auth-footer">
                    ¿No tienes cuenta?
                    <a href="{{ path('app_register') }}">Crear cuenta</a>
                </p>
            </form>
        </div>
    </section>
{% endblock %}
