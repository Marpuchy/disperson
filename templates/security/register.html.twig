{% extends 'base.html.twig' %}

{% block title %}Disperson | Crear cuenta{% endblock %}
{% block body_class %}page-auth{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/auth.css') }}">
{% endblock %}

{% block content %}
    <section class="auth-shell">
        <div class="auth-panel auth-panel--copy" data-reveal>
            <span class="section-tag">Registro</span>
            <h1>Crea tu cuenta y guarda tu perfil.</h1>
            <p>
                El registro permite persistir resultados, revisar tu perfil interpretado y mantener una experiencia completa de usuario.
            </p>
        </div>

        <div class="auth-panel" data-reveal>
            {{ form_start(registrationForm, { attr: { class: 'auth-form' } }) }}
                <div class="form-field">
                    {{ form_label(registrationForm.email) }}
                    {{ form_widget(registrationForm.email) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="form-field">
                    {{ form_label(registrationForm.username) }}
                    {{ form_widget(registrationForm.username) }}
                    {{ form_errors(registrationForm.username) }}
                </div>

                <div class="form-field">
                    {{ form_label(registrationForm.password.first) }}
                    {{ form_widget(registrationForm.password.first) }}
                    {{ form_errors(registrationForm.password.first) }}
                </div>

                <div class="form-field">
                    {{ form_label(registrationForm.password.second) }}
                    {{ form_widget(registrationForm.password.second) }}
                    {{ form_errors(registrationForm.password.second) }}
                </div>

                <button type="submit" class="btn btn-primary site-btn w-100">Crear cuenta</button>

                <p class="auth-footer">
                    ¿Ya tienes cuenta?
                    <a href="{{ path('app_login') }}">Inicia sesión</a>
                </p>
            {{ form_end(registrationForm) }}
        </div>
    </section>
{% endblock %}
