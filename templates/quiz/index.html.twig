{% extends 'base.html.twig' %}

{% block title %}Iniciar Cuestionario{% endblock %}

{% block content %}
<div class="container mt-5">
    <h1 class="text-center mb-4">{{ quiz_info.title }}</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">{{ quiz_info.description }}</h5>
            <p class="card-text">
                <strong>Total de Preguntas:</strong> {{ quiz_info.total_questions }} <br>
                <strong>Tiempo Límite:</strong> {{ quiz_info.time_limit }}
            </p>
            <hr>
            <div class="text-center">
                <a href="#" class="btn btn-success btn-lg">Comenzar Ahora</a>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <a href="{{ path('app_home') }}" class="btn btn-primary">Volver al Inicio</a>
    </div>
</div>
{% endblock %}