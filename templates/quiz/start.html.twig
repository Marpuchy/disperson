{% extends 'base.html.twig' %}

{% block title %}Iniciar Cuestionario{% endblock %}

{% block content %}
    <!-- Estilos y scripts de Owl Carousel -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".switch").forEach(switchContainer => {
                const radios = switchContainer.querySelectorAll("input[type='radio']");

                // Ocultar la etiqueta de la opción marcada por defecto
                const checkedRadio = switchContainer.querySelector("input[type='radio']:checked");
                if (checkedRadio) {
                    const selectedLabel = checkedRadio.nextElementSibling;
                    if (selectedLabel) {
                        selectedLabel.style.visibility = "hidden";
                    }
                }

                // Evento para ocultar la etiqueta al seleccionar una nueva opción
                radios.forEach(radio => {
                    radio.addEventListener("change", function () {
                        // Mostrar todas las etiquetas en este grupo de preguntas
                        switchContainer.querySelectorAll(".switch__label").forEach(label => {
                            label.style.visibility = "visible";
                        });

                        // Ocultar solo la etiqueta del input seleccionado
                        const selectedLabel = this.nextElementSibling;
                        if (selectedLabel) {
                            selectedLabel.style.visibility = "hidden";
                        }
                    });
                });
            });
        });


        $(document).ready(function () {
            var owl = $("#owl-demo1");

            owl.owlCarousel({
                loop: false,
                margin: 0,
                nav: false,
                autoplay: false,
                dots: false,
                items: 1,
                autoHeight: true,
                responsiveClass: true,
                touchDrag: true,
                mouseDrag: true,
                pullDrag: true,
                smartSpeed: 300,
                preventClicks: true, // Evita que el click dispare la acción de cambio de página de forma no deseada
                preventClicksPropagation: true, // Evita la propagación del click hacia otros elementos
                responsive: {
                    0: {
                        items: 1,
                        nav: false,
                    },
                    600: {
                        items: 1,
                        nav: false,
                    },
                    1000: {
                        items: 1,
                        nav: true,
                        loop: false,
                    }
                }
            });



            // Conectar los botones personalizados con la funcionalidad de Owl Carousel
            $(".owl-prev").click(function () {
                owl.trigger('prev.owl.carousel');
            });

            $(".owl-next").click(function () {
                owl.trigger('next.owl.carousel');
            });
        });
    </script>
    <link href="{{ asset('css/quiz.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <div class="container quizContainer mt-5">
        <h1 class="text-center mb-4">Cuestionario de Personalidad</h1>

        <form action="{{ path('app_quiz_submit') }}" method="POST">
            <div class="owl-carousel-wrapper position-relative">
                <div id="owl-demo1" class="owl-carousel">
                    {% set questionChunks = questions|batch(4) %} <!-- Se dividen las preguntas en bloques -->
                    {% for chunk in questionChunks %}
                        <div class="allitem">
                            <div class="owl-nav-container d-flex justify-content-between">
                                <button type="button" class="btn btn-primary owl-prev">
                                    <img src="{{ asset('resources/arrow-left.svg') }}">
                                </button>
                            </div>
                            <div class="blog-allof">
                                <div class="discretion-blog">
                                    <div class="customContainer">
                                        <div class="row">
                                            {% for question in chunk %}
                                                <div class="col-12 mb-3">
                                                    <h3 class="question-text">{{ question.content }}</h3>
                                                    <div class="switch">
                                                        <input name="question_{{ question.id }}"
                                                               id="question_{{ question.id }}_-2" type="radio"
                                                               value="-2" class="question-radio-_-2"/>
                                                        <label for="question_{{ question.id }}_-2"
                                                               class="switch__label"><i class="fa-solid fa-face-sad-tear" id="face1"></i></label>

                                                        <input name="question_{{ question.id }}"
                                                               id="question_{{ question.id }}_-1" type="radio"
                                                               value="-1" class="question-radio-_-1"/>
                                                        <label for="question_{{ question.id }}_-1"
                                                               class="switch__label"><i class="fa-solid fa-face-frown" id="face2"></i></label>

                                                        <input name="question_{{ question.id }}"
                                                               id="question_{{ question.id }}_0" type="radio" value="0"
                                                               class="question-radio-0" checked/>
                                                        <label for="question_{{ question.id }}_0" class="switch__label"><i class="fa-solid fa-face-meh" id="face3"></i></label>

                                                        <input name="question_{{ question.id }}"
                                                               id="question_{{ question.id }}_1" type="radio" value="1"
                                                               class="question-radio-1"/>
                                                        <label for="question_{{ question.id }}_1" class="switch__label"><i class="fa-solid fa-face-smile" id="face4"></i></label>

                                                        <input name="question_{{ question.id }}"
                                                               id="question_{{ question.id }}_2" type="radio" value="2"
                                                               class="question-radio-2"/>
                                                        <label for="question_{{ question.id }}_2" class="switch__label"><i class="fa-solid fa-face-grin" id="face5" ></i></label>

                                                        <div class="switch__indicator"></div>
                                                    </div>

                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Nuevo contenedor para los botones de navegación -->
                            <div class="owl-nav-container d-flex justify-content-between">
                                <button type="button" class="btn btn-primary owl-next">
                                    <img src="{{ asset('resources/arrow-right.svg') }}">
                                </button>
                            </div>
                        </div>
                    {% endfor %}

                    <!-- Diapositiva final con el botón de enviar respuestas -->
                    <div>
                        <div class="blog-allof">
                            <div class="discretion-blog">
                                <div class="customContainer">
                                    <div class="row justify-content-center">
                                        <div class="col-12 text-center">
                                            <h3 class="question-text">Gracias por completar el cuestionario</h3>
                                            <p>Haz clic en el botón de abajo para enviar tus respuestas.</p>
                                            <button type="submit" class="btn btn-success btn-lg">Enviar Respuestas
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

{% endblock %}
