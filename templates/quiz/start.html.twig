{% extends 'base.html.twig' %}

{% block title %}Iniciar Cuestionario{% endblock %}

{% block content %}
    <div class="container mt-5">
        <h1 class="text-center mb-4">Cuestionario de Personalidad</h1>

        <form action="{{ path('app_quiz_submit') }}" method="POST">
            <!-- Carrusel de preguntas -->
            <div id="quizCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    {% set questionChunks = questions|batch(5) %}
                    {% for chunk in questionChunks %}
                        <div class="carousel-item {% if loop.first %}active{% endif %}">
                            <div class="container">
                                {% for question in chunk %}
                                    <div class="mb-4">
                                        <h5>{{ question.content }}</h5>

                                        <!-- Opciones de respuesta -->
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}_experiencia" value="1" id="experiencia_{{ question.id }}">
                                            <label class="form-check-label" for="experiencia_{{ question.id }}">
                                                Estoy muy de acuerdo
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}_responsabilidad" value="1" id="responsabilidad_{{ question.id }}">
                                            <label class="form-check-label" for="responsabilidad_{{ question.id }}">
                                                De acuerdo
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}_extraversion" value="1" id="extraversion_{{ question.id }}">
                                            <label class="form-check-label" for="extraversion_{{ question.id }}">
                                                Indiferente
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}_emocional" value="1" id="emocional_{{ question.id }}">
                                            <label class="form-check-label" for="emocional_{{ question.id }}">
                                                En desacuerdo
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}_amabilidad" value="1" id="amabilidad_{{ question.id }}">
                                            <label class="form-check-label" for="amabilidad_{{ question.id }}">
                                                Muy en desacuerdo
                                            </label>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Controles del carrusel fuera del contenedor -->
            <div class="d-flex justify-content-between">
                <button class="carousel-control-prev" type="button" data-bs-target="#quizCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#quizCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success btn-lg">Enviar Respuestas</button>
            </div>
        </form>
    </div>

    <!-- Incluir los scripts de Bootstrap al final -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js"></script>
{% endblock %}
