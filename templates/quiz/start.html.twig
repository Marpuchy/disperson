{% extends 'base.html.twig' %}

{% block title %}Iniciar Cuestionario{% endblock %}

{% block content %}
    <div class="container quizContainer mt-5">
        <h1 class="text-center mb-4">Cuestionario de Personalidad</h1>

        <form action="{{ path('app_quiz_submit') }}" method="POST">
            <div class="owl-carousel-wrapper position-relative">
                <div id="owl-demo1" class="owl-carousel">
                    {% set questionChunks = questions|batch(4) %} <!-- Se dividen las preguntas en bloques -->
                    {% for chunk in questionChunks %}
                        <div class="allitem">
                            <div class="owl-nav-container d-flex justify-content-between">
                                <button type="button" class="btn btn-primary owl-prev">
                                    <img src="{{ asset('resources/arrow-left.svg') }}">
                                </button>
                            </div>
                            <div class="blog-allof">
                                <div class="discretion-blog">
                                    <div class="customContainer">
                                        <div class="row">
                                            {% for question in chunk %}
                                                <div class="col-12 mb-3">
                                                    <h3 class="question-text">{{ question.content }}</h3>
                                                    <div class="d-flex justify-content-around flex-wrap">
                                                        <div class="form-check form-check-inline custom-radio">
                                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="-2" id="question_{{ question.id }}_-2">
                                                            <label class="form-check-label" for="question_{{ question.id }}_-2">
                                                                Muy en desacuerdo
                                                            </label>
                                                        </div>
                                                        <div class="form-check form-check-inline custom-radio">
                                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="-1" id="question_{{ question.id }}_-1">
                                                            <label class="form-check-label" for="question_{{ question.id }}_-1">
                                                                En desacuerdo
                                                            </label>
                                                        </div>
                                                        <div class="form-check form-check-inline custom-radio">
                                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="0" id="question_{{ question.id }}_0">
                                                            <label class="form-check-label" for="question_{{ question.id }}_0">
                                                                Indiferente
                                                            </label>
                                                        </div>
                                                        <div class="form-check form-check-inline custom-radio">
                                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="1" id="question_{{ question.id }}_1">
                                                            <label class="form-check-label" for="question_{{ question.id }}_1">
                                                                De acuerdo
                                                            </label>
                                                        </div>
                                                        <div class="form-check form-check-inline custom-radio">
                                                            <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="2" id="question_{{ question.id }}_2">
                                                            <label class="form-check-label" for="question_{{ question.id }}_2">
                                                                Muy de acuerdo
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Nuevo contenedor para los botones de navegación -->
                            <div class="owl-nav-container d-flex justify-content-between">
                                <button type="button" class="btn btn-primary owl-next">
                                    <img src="{{ asset('resources/arrow-right.svg') }}">
                                </button>
                            </div>
                        </div>
                    {% endfor %}

                    <!-- Diapositiva final con el botón de enviar respuestas -->
                    <div>
                        <div class="blog-allof">
                            <div class="discretion-blog">
                                <div class="customContainer">
                                    <div class="row justify-content-center">
                                        <div class="col-12 text-center">
                                            <h3 class="question-text">Gracias por completar el cuestionario</h3>
                                            <p>Haz clic en el botón de abajo para enviar tus respuestas.</p>
                                            <button type="submit" class="btn btn-success btn-lg">Enviar Respuestas</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <!-- Estilos y scripts de Owl Carousel -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>

    <script>
        $(document).ready(function() {
            var owl = $("#owl-demo1");

            owl.owlCarousel({
                loop: false,
                margin: 0,
                nav: false,
                autoplay: false,
                dots: false,
                items: 1,
                autoHeight: true, // Esto asegura que cada diapositiva ajuste su altura automáticamente.
                responsiveClass: true,
                responsive: {
                    0: {
                        items: 1,
                        nav: false,
                    },
                    600: {
                        items: 1,
                        nav: false,
                    },
                    1000: {
                        items: 1,
                        nav: true,
                        loop: false,
                    }
                }
            });

            // Conectar los botones personalizados con la funcionalidad de Owl Carousel
            $(".owl-prev").click(function() {
                owl.trigger('prev.owl.carousel');
            });

            $(".owl-next").click(function() {
                owl.trigger('next.owl.carousel');
            });
        });
    </script>
{% endblock %}