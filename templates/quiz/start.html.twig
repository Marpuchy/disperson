{% extends 'base.html.twig' %}

{% block title %}Iniciar Cuestionario{% endblock %}

{% block content %}
    <div class="container mt-5">
        <h1 class="text-center mb-4">Cuestionario de Personalidad</h1>

        <form action="{{ path('app_quiz_submit') }}" method="POST">
            <!-- Carrusel de preguntas sin movimiento automático -->
            <div id="quizCarousel" class="carousel slide">
                <div class="carousel-inner">
                    {% set questionChunks = questions|batch(5) %}
                    {% for chunk in questionChunks %}
                        <div class="carousel-item {% if loop.first %}active{% endif %}">
                            <div class="container">
                                {% for question in chunk %}
                                    <div class="mb-4">
                                        <h5>{{ question.content }}</h5>

                                        <!-- Opciones de respuesta (ordenadas visualmente de -2 a 2) -->
                                        <div class="d-flex justify-content-around">
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="-2" id="question_{{ question.id }}_-2">
                                                <label class="form-check-label" for="question_{{ question.id }}_-2">
                                                    Muy en desacuerdo
                                                </label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="-1" id="question_{{ question.id }}_-1">
                                                <label class="form-check-label" for="question_{{ question.id }}_-1">
                                                    En desacuerdo
                                                </label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="0" id="question_{{ question.id }}_0">
                                                <label class="form-check-label" for="question_{{ question.id }}_0">
                                                    Me da igual
                                                </label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="1" id="question_{{ question.id }}_1">
                                                <label class="form-check-label" for="question_{{ question.id }}_1">
                                                    De acuerdo
                                                </label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="question_{{ question.id }}" value="2" id="question_{{ question.id }}_2">
                                                <label class="form-check-label" for="question_{{ question.id }}_2">
                                                    Muy de acuerdo
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Controles del carrusel fuera del contenedor -->
            <div class="d-flex justify-content-between">
                <button class="carousel-control-prev" type="button" data-bs-target="#quizCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#quizCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-success btn-lg">Enviar Respuestas</button>
            </div>
        </form>
    </div>

    <!-- Incluir los scripts de Bootstrap al final -->
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js"></script>
{% endblock %}
