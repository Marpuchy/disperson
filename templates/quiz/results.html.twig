{% extends 'base.html.twig' %}

{% block title %}Disperson | Resultados{% endblock %}
{% block body_class %}page-results{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/quiz.css') }}">
{% endblock %}

{% block content %}
    <section class="results-shell">
        <div class="results-header" data-reveal>
            <span class="section-tag">Resultados</span>
            <h1>Ya tienes una lectura inicial de tu perfil OCEAN.</h1>
            <p>
                Estas son tus puntuaciones actuales por dimensión. El perfil completo añade interpretación por rasgo, lectura visual y personajes asociados.
            </p>
        </div>

        <div class="results-grid">
            {% for trait in traits %}
                {% include '_components/trait_metric.html.twig' with { trait: trait } %}
            {% endfor %}
        </div>

        <div class="results-actions" data-reveal>
            <a href="{{ path('app_profile') }}" class="btn btn-primary site-btn">Abrir perfil completo</a>
            <a href="{{ path('app_quiz_start') }}" class="btn btn-outline-primary site-btn site-btn--ghost">Repetir test</a>
        </div>
    </section>
{% endblock %}
