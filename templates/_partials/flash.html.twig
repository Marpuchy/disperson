{% if app.request is defined and app.request.hasPreviousSession %}
    {% for type, messages in app.flashes %}
        <div class="container-xxl flash-stack">
            {% for message in messages %}
                <div class="flash flash--{{ type }}">
                    {{ message }}
                </div>
            {% endfor %}
        </div>
    {% endfor %}
{% endif %}
