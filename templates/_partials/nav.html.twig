{% set currentRoute = app.request.attributes.get('_route') %}

<header class="site-header">
    <nav class="navbar navbar-expand-lg site-navbar">
        <div class="container-xxl">
            <a class="navbar-brand site-brand" href="{{ path('app_home') }}">
                <span class="site-brand__mark">D</span>
                <span>Disperson</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav" aria-controls="siteNav" aria-expanded="false" aria-label="Abrir navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="siteNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link {{ currentRoute == 'app_home' ? 'is-active' }}" href="{{ path('app_home') }}">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ currentRoute == 'app_about' ? 'is-active' }}" href="{{ path('app_about') }}">Proyecto</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ currentRoute == 'app_contact' ? 'is-active' }}" href="{{ path('app_contact') }}">Contacto</a>
                    </li>

                    {% if app.user %}
                        <li class="nav-item">
                            <a class="nav-link {{ currentRoute starts with 'app_quiz_' ? 'is-active' }}" href="{{ path('app_quiz_start') }}">Test</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ currentRoute == 'app_profile' ? 'is-active' }}" href="{{ path('app_profile') }}">Perfil</a>
                        </li>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="nav-item">
                                <a class="nav-link {{ currentRoute == 'admin' ? 'is-active' }}" href="{{ path('admin') }}">Admin</a>
                            </li>
                        {% endif %}
                        <li class="nav-item ms-lg-2">
                            <span class="nav-user">{{ app.user.username }}</span>
                        </li>
                    {% else %}
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-outline-primary btn-sm site-btn site-btn--ghost" href="{{ path('app_login') }}">Entrar</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm site-btn" href="{{ path('app_register') }}">Crear cuenta</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
</header>
