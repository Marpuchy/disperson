{% extends 'base.html.twig' %}

{% block title %}Disperson | Test Big Five{% endblock %}
{% block meta_description %}Experiencia web de personalidad basada en Big Five / OCEAN, con perfil interpretado y personajes asociados.{% endblock %}
{% block body_class %}page-home{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/home.css') }}">
{% endblock %}

{% block content %}
    {% set visual_panels = [
        {
            image: '24.jpg',
            eyebrow: 'Resultado principal',
            title: 'Un retrato visual para el rasgo que mas define tu perfil.',
            text: 'La primera lectura mezcla puntuacion, nivel y personaje asociado en una sola escena.'
        },
        {
            image: '7.jpg',
            eyebrow: 'Memoria del perfil',
            title: 'Asociaciones faciles de recordar',
            text: 'La capa Disney ayuda a volver a una lectura mas emocional sin quitarle peso al modelo.'
        },
        {
            image: '20.jpg',
            eyebrow: 'Banco visual',
            title: 'Mas de un resultado posible',
            text: 'Cada combinacion de rasgo y nivel puede apuntar a un personaje diferente dentro del sistema.'
        }
    ] %}

    <section class="hero-section">
        <div class="container-xxl hero-showcase">
            <div class="hero-copy" data-reveal>
                <span class="section-tag">Big Five / OCEAN / Perfil visual</span>
                <h1>Descubre tu mezcla de rasgos y conviertela en un perfil visual con atmosfera propia.</h1>
                <p class="lead-text">
                    Disperson une psicologia interpretativa, preguntas dinamicas y una capa Disney que vuelve el resultado
                    mas memorable sin sacar a OCEAN del centro.
                </p>

                <div class="hero-actions">
                    <a class="btn btn-primary site-btn" href="{{ path('app_quiz_start') }}">Empezar test</a>
                    <a class="btn btn-outline-primary site-btn site-btn--ghost" href="{{ path('app_about') }}">Como funciona</a>
                </div>

                <div class="hero-metrics">
                    <div class="hero-metric">
                        <strong>5</strong>
                        <span>dimensiones OCEAN</span>
                    </div>
                    <div class="hero-metric">
                        <strong>BD</strong>
                        <span>preguntas dinamicas</span>
                    </div>
                    <div class="hero-metric">
                        <strong>1</strong>
                        <span>perfil persistido por usuario</span>
                    </div>
                </div>

                <div class="signal-ribbon">
                    <span class="signal-pill">Big Five en el centro</span>
                    <span class="signal-pill">Preguntas dinamicas desde BD</span>
                    <span class="signal-pill">Perfil visual persistido</span>
                </div>
            </div>

            <div class="hero-stage" data-reveal>
                <article class="hero-card hero-card--primary hero-stage__panel">
                    <div class="hero-stage__media">
                        <img
                            src="{{ asset('resources/characters/' ~ visual_panels[0].image) }}"
                            alt="Resultado visual principal de Disperson"
                            width="560"
                            height="700"
                            decoding="async"
                            fetchpriority="high"
                        >
                    </div>

                    <div class="hero-stage__body">
                        <div>
                            <p class="hero-card__eyebrow">Resultado principal</p>
                            <h2>Rasgo dominante, nivel y personaje asociado en una sola mirada.</h2>
                            <p>
                                El flujo cruza scoring, interpretacion y narrativa visual para que el perfil se vea mas cercano
                                desde la primera pantalla.
                            </p>
                        </div>

                        <div class="hero-stage__meta">
                            <div class="hero-stage__metric">
                                <span>Modelo</span>
                                <strong>OCEAN</strong>
                            </div>
                            <div class="hero-stage__metric">
                                <span>Salida</span>
                                <strong>Radar + perfil</strong>
                            </div>
                            <div class="hero-stage__metric">
                                <span>Lectura</span>
                                <strong>Psico + visual</strong>
                            </div>
                        </div>

                        <div class="hero-orbit">
                            {% for trait in traits %}
                                <div class="hero-orbit__node">
                                    <strong>{{ trait.letter }}</strong>
                                    <span>{{ trait.navigation_label }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </article>

                <div class="hero-stage__side">
                    {% for panel in visual_panels|slice(1) %}
                        <article class="hero-card hero-mini-card">
                            <div class="hero-mini-card__thumb">
                                <img
                                    src="{{ asset('resources/characters/' ~ panel.image) }}"
                                    alt="{{ panel.title }}"
                                    width="320"
                                    height="320"
                                    loading="lazy"
                                    decoding="async"
                                >
                            </div>
                            <div>
                                <p class="hero-card__eyebrow">{{ panel.eyebrow }}</p>
                                <h3>{{ panel.title }}</h3>
                                <p>{{ panel.text }}</p>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>

    <section class="section-block section-block--dense" data-deferred>
        <div class="container-xxl landing-mosaic">
            <article class="feature-card landing-mosaic__wide" data-reveal>
                <div class="section-heading section-heading--compact">
                    <span class="section-tag">Recorrido</span>
                    <h2>De respuestas guardadas a un perfil que se entiende rapido y se recuerda mejor.</h2>
                </div>

                <div class="journey-strip">
                    <article class="journey-step">
                        <span class="journey-step__index">01</span>
                        <div>
                            <h3>Banco de preguntas real</h3>
                            <p>Doctrine recupera preguntas editables en base de datos para que el test no dependa de arrays estaticos.</p>
                        </div>
                    </article>
                    <article class="journey-step">
                        <span class="journey-step__index">02</span>
                        <div>
                            <h3>Scoring fiel al proyecto</h3>
                            <p>Las respuestas se traducen a una escala 0-100 con inversion de items, clamp y persistencia por usuario.</p>
                        </div>
                    </article>
                    <article class="journey-step">
                        <span class="journey-step__index">03</span>
                        <div>
                            <h3>Resultado memorable</h3>
                            <p>El perfil combina interpretacion psicologica, radar y personajes como capa emocional del resultado.</p>
                        </div>
                    </article>
                </div>
            </article>

            <article class="feature-card mosaic-note" data-reveal>
                <p class="hero-card__eyebrow">Base psicologica</p>
                <h3>OCEAN sigue siendo el nucleo de toda la experiencia.</h3>
                <p>La capa visual hace mas recordable el resultado, pero no reemplaza el modelo ni el sentido interpretativo del proyecto.</p>
            </article>

            <article class="feature-card mosaic-note" data-reveal>
                <p class="hero-card__eyebrow">Narrativa visual</p>
                <h3>El personaje aparece como recompensa, no como maquillaje.</h3>
                <p>Se ve pronto, se entiende rapido y convierte el perfil en algo mas facil de recordar y compartir.</p>
            </article>
        </div>
    </section>

    <section class="section-block section-block--dense" data-deferred>
        <div class="container-xxl discovery-layout">
            <article class="feature-card trait-wall" data-reveal>
                <div class="section-heading section-heading--compact">
                    <span class="section-tag">Modelo OCEAN</span>
                    <h2>Cinco dimensiones visibles en una misma escena.</h2>
                </div>

                <div class="trait-wall__grid">
                    {% for trait in traits %}
                        <article class="trait-wall__card">
                            <div class="trait-wall__top">
                                <span class="trait-wall__letter">{{ trait.letter }}</span>
                                <p class="hero-card__eyebrow">{{ trait.label }}</p>
                            </div>
                            <p>{{ trait.summary }}</p>
                            <div class="trait-wall__anchors">
                                <span>{{ trait.low_anchor }}</span>
                                <span>{{ trait.high_anchor }}</span>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </article>

            <article class="feature-card gallery-panel" data-reveal>
                <div class="section-heading section-heading--compact">
                    <span class="section-tag">Capa Disney</span>
                    <h2>El resultado no solo se lee: tambien se ve y se recuerda.</h2>
                </div>

                <div class="gallery-panel__grid">
                    {% for panel in visual_panels %}
                        <figure class="gallery-panel__card">
                            <div class="gallery-panel__thumb">
                                <img
                                    src="{{ asset('resources/characters/' ~ panel.image) }}"
                                    alt="{{ panel.title }}"
                                    width="360"
                                    height="420"
                                    loading="lazy"
                                    decoding="async"
                                >
                            </div>
                            <figcaption>
                                <p class="hero-card__eyebrow">{{ panel.eyebrow }}</p>
                                <h3>{{ panel.title }}</h3>
                                <p>{{ panel.text }}</p>
                            </figcaption>
                        </figure>
                    {% endfor %}
                </div>
            </article>
        </div>
    </section>

    <section class="section-block section-block--accent" data-deferred>
        <div class="container-xxl cta-banner cta-banner--visual" data-reveal>
            <div>
                <span class="section-tag">Siguiente paso</span>
                <h2>Entra al flujo real y deja que tu perfil tome forma.</h2>
                <p class="cta-banner__note">
                    Login, cuestionario y perfil final conviven dentro de la misma experiencia para que el recorrido se sienta continuo.
                </p>
            </div>
            <div class="cta-banner__actions">
                <a class="btn btn-primary site-btn" href="{{ path('app_quiz_start') }}">Ir al cuestionario</a>
                <a class="btn btn-outline-primary site-btn site-btn--ghost" href="{{ path('app_profile') }}">Abrir perfil</a>
            </div>
        </div>
    </section>
{% endblock %}
