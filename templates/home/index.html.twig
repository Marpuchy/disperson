{% extends 'base.html.twig' %}

{% block title %}Página Principal{% endblock %}

{% block content %}
    <div class="container mt-5">

        <!-- Zona de Información -->
        <section class="mb-5">
            <div class="p-4 bg-light rounded">
                <h2 class="text-center mb-3">Bienvenido a Nuestra Plataforma</h2>
                <p class="text-center">
                    Aquí encontrarás información útil sobre cómo usar nuestras herramientas y servicios.
                    ¡Explora las diferentes secciones para aprender más!
                </p>
            </div>
        </section>

        <!-- Zona de Perfil -->
        <section class="mb-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title text-center">Tu Perfil</h3>
                    <p class="card-text text-center">
                        Accede a tus datos, edita tu información o consulta tu progreso.
                    </p>
                    <div class="text-center">
                        <a href="{{ path('app_profile') }}" class="btn btn-primary">Gestionar Perfil</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Zona de Empezar Cuestionario -->
        <section class="text-center">
            <div class="p-5 bg-primary text-white rounded">
                <h3 class="mb-3">¿Listo para empezar?</h3>
                <p>Haz clic en el botón a continuación para iniciar tu cuestionario.</p>
                <a href="{{ path('app_quiz_start') }}" class="btn btn-light btn-lg">Empezar Cuestionario</a>
            </div>
        </section>

    </div>
{% endblock %}