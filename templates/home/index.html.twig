{% extends 'base.html.twig' %}

{% block title %}Disperson | Test Big Five{% endblock %}
{% block meta_description %}Experiencia web de personalidad basada en Big Five / OCEAN, con perfil interpretado y personajes asociados.{% endblock %}
{% block body_class %}page-home{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/home.css') }}">
{% endblock %}

{% block content %}
    {% set hero_scores = [
        { label: 'Experiencia', value: 78 },
        { label: 'Responsabilidad', value: 64 },
        { label: 'Amabilidad', value: 71 }
    ] %}

    {% set ocean_teasers = {
        experiencia: 'Curiosidad, imaginacion y apertura ante lo nuevo.',
        responsabilidad: 'Orden, constancia y capacidad para sostener compromisos.',
        extraversion: 'Energia social, iniciativa y comodidad en contextos activos.',
        amabilidad: 'Empatia, cooperacion y sensibilidad hacia los demas.',
        emocional: 'Calma, regulacion y respuesta equilibrada ante la presion.'
    } %}

    {% set journey_steps = [
        {
            index: '01',
            title: 'Responde con naturalidad',
            text: 'Cada bloque te invita a reaccionar ante situaciones cotidianas para captar como sueles pensar, sentir y actuar.'
        },
        {
            index: '02',
            title: 'Observa tu mapa de rasgos',
            text: 'La lectura transforma tus respuestas en un retrato OCEAN facil de entender, con matices y equilibrio entre dimensiones.'
        },
        {
            index: '03',
            title: 'Reconoce tu reflejo visual',
            text: 'El perfil final une interpretacion psicologica y una asociacion visual para que la experiencia deje una huella mas emocional.'
        }
    ] %}

    {% set collaborators = [
        {
            eyebrow: 'Autoria',
            title: 'Marc Ibanez Puchol',
            text: 'Direccion creativa, narrativa visual y construccion de una experiencia centrada en personalidad, atmosfera y lectura interpretativa.'
        },
        {
            eyebrow: 'Colaboracion UJI',
            title: 'Base psicometrica',
            text: 'La experiencia se apoya en una colaboracion real que aporta contexto academico al cuestionario y su narrativa.'
        }
    ] %}

    {% set access_cards = [
        {
            index: '01',
            title: 'Entrar en tu espacio',
            text: 'Accede a una experiencia personal para comenzar o retomar tu lectura de rasgos.',
            href: path('app_login'),
            label: 'Entrar'
        },
        {
            index: '02',
            title: 'Test',
            text: 'Responde el cuestionario y descubre como se distribuyen tus cinco dimensiones de personalidad.',
            href: path('app_quiz_start'),
            label: 'Ir al test'
        },
        {
            index: '03',
            title: 'Conocer el enfoque',
            text: 'Explora la idea que une autoconocimiento, interpretacion y una capa visual inspirada en personajes.',
            href: path('app_about'),
            label: 'Saber mas'
        }
    ] %}

    <section class="hero-section">
        <div class="container-xxl hero-layout">
            <div class="hero-copy" data-reveal>
                <span class="section-tag">Big Five / OCEAN / Perfil visual</span>
                <h1>Descubre tu mezcla de rasgos y conviertela en un perfil visual con atmosfera propia.</h1>
                <p class="lead-text">
                    Disperson convierte la exploracion de la personalidad en una experiencia guiada, visual y facil de recordar.
                </p>

                <div class="hero-actions">
                    <a class="btn btn-primary site-btn" href="{{ path('app_quiz_start') }}">Empezar test</a>
                    <a class="btn btn-outline-primary site-btn site-btn--ghost" href="{{ path('app_about') }}">Conocer la experiencia</a>
                </div>

                <div class="hero-stats" aria-label="Indicadores clave del producto">
                    <div class="hero-stat">
                        <strong>5</strong>
                        <span>dimensiones de personalidad</span>
                    </div>
                    <div class="hero-stat">
                        <strong>Lectura</strong>
                        <span>interpretacion clara</span>
                    </div>
                    <div class="hero-stat">
                        <strong>Perfil</strong>
                        <span>visual unico</span>
                    </div>
                </div>
            </div>

            <div class="hero-visual" data-reveal>
                <article class="hero-showcase-card">
                    <div class="hero-showcase-card__overview">
                        <div class="hero-showcase-card__header">
                            <p class="hero-card__eyebrow">Preview del resultado</p>
                            <h2>Un retrato de personalidad que se entiende rapido y se recuerda mejor.</h2>
                        </div>

                        <p class="hero-showcase-card__summary">
                            Rasgos, interpretacion y personaje asociado aparecen en una sola escena para que la lectura se sienta inmediata.
                        </p>
                    </div>

                    <div class="hero-showcase-card__main">
                        <div class="hero-showcase-card__media">
                            <div class="hero-showcase-card__media-frame">
                                <img
                                    src="{{ asset('resources/characters/24.jpg') }}"
                                    alt="Representacion visual del resultado de Disperson"
                                    width="760"
                                    height="940"
                                    decoding="async"
                                    fetchpriority="high"
                                >
                            </div>
                        </div>

                        <div class="hero-radar-preview">
                            <div class="hero-radar-preview__chart" aria-hidden="true">
                                <svg viewBox="0 0 220 220" role="presentation">
                                    <polygon class="hero-radar-preview__grid" points="110,22 192,83 160,184 60,184 28,83"></polygon>
                                    <polygon class="hero-radar-preview__grid" points="110,48 167,90 145,160 75,160 53,90"></polygon>
                                    <polygon class="hero-radar-preview__grid" points="110,74 142,98 131,136 89,136 78,98"></polygon>
                                    <line class="hero-radar-preview__axis" x1="110" y1="110" x2="110" y2="22"></line>
                                    <line class="hero-radar-preview__axis" x1="110" y1="110" x2="192" y2="83"></line>
                                    <line class="hero-radar-preview__axis" x1="110" y1="110" x2="160" y2="184"></line>
                                    <line class="hero-radar-preview__axis" x1="110" y1="110" x2="60" y2="184"></line>
                                    <line class="hero-radar-preview__axis" x1="110" y1="110" x2="28" y2="83"></line>
                                    <polygon class="hero-radar-preview__shape" points="110,41 163,94 145,150 82,164 70,89"></polygon>
                                    <circle class="hero-radar-preview__point" cx="110" cy="41" r="5"></circle>
                                    <circle class="hero-radar-preview__point" cx="163" cy="94" r="5"></circle>
                                    <circle class="hero-radar-preview__point" cx="145" cy="150" r="5"></circle>
                                    <circle class="hero-radar-preview__point" cx="82" cy="164" r="5"></circle>
                                    <circle class="hero-radar-preview__point" cx="70" cy="89" r="5"></circle>
                                </svg>
                            </div>

                            <div class="hero-radar-preview__scores">
                                {% for score in hero_scores %}
                                    <div class="hero-score-row">
                                        <div class="hero-score-row__copy">
                                            <span>{{ score.label }}</span>
                                            <div class="hero-score-row__bar" style="--fill: {{ score.value }}%;"></div>
                                        </div>
                                        <strong>{{ score.value }}</strong>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <div class="hero-showcase-card__metrics">
                        <div class="hero-showcase-card__metric">
                            <strong>Lectura</strong>
                            <span>Mapa de rasgos claro</span>
                        </div>
                        <div class="hero-showcase-card__metric">
                            <strong>Interpretacion</strong>
                            <span>Significado facil de recorrer</span>
                        </div>
                        <div class="hero-showcase-card__metric">
                            <strong>Personaje</strong>
                            <span>Asociacion emocional del perfil</span>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="section-block home-section home-section--clean" data-deferred>
        <div class="container-xxl ocean-section">
            <div class="ocean-section__intro" data-reveal>
                <span class="section-tag">El nucleo de la experiencia</span>
                <h2>Las cinco dimensiones OCEAN ordenan toda la experiencia.</h2>
                <p>
                    Cada rasgo ilumina una parte distinta de tu manera de estar en el mundo. La capa visual acompana, pero la lectura nace siempre del Big Five.
                </p>
            </div>

            <div class="ocean-grid">
                <div class="ocean-grid__row ocean-grid__row--top">
                    {% for trait in traits|slice(0, 3) %}
                        <article class="ocean-card" data-reveal>
                            <div class="ocean-card__top">
                                <span class="ocean-card__letter">{{ trait.letter }}</span>
                                <h3>{{ trait.label }}</h3>
                            </div>
                            <p>{{ ocean_teasers[trait.key] }}</p>
                            <div class="ocean-card__anchors">
                                <span>{{ trait.low_anchor }}</span>
                                <span>{{ trait.high_anchor }}</span>
                            </div>
                        </article>
                    {% endfor %}
                </div>

                <div class="ocean-grid__row ocean-grid__row--bottom">
                    {% for trait in traits|slice(3, 2) %}
                        <article class="ocean-card" data-reveal>
                            <div class="ocean-card__top">
                                <span class="ocean-card__letter">{{ trait.letter }}</span>
                                <h3>{{ trait.label }}</h3>
                            </div>
                            <p>{{ ocean_teasers[trait.key] }}</p>
                            <div class="ocean-card__anchors">
                                <span>{{ trait.low_anchor }}</span>
                                <span>{{ trait.high_anchor }}</span>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </div>

            <div class="ocean-support" data-reveal>
                <strong>La capa visual no desplaza al modelo.</strong>
                <p>Los personajes funcionan como eco emocional de la lectura, mientras que el sentido del perfil sigue organizado por rasgos, niveles y matices.</p>
            </div>
        </div>
    </section>

    <section class="section-block section-block--dense" data-deferred>
        <div class="container-xxl journey-layout">
            <div class="journey-layout__intro" data-reveal>
                <span class="section-tag">Como se vive la experiencia</span>
                <h2>Un recorrido pensado para pasar de la intuicion a una lectura que deja huella.</h2>
                <p>
                    Cada etapa prepara la siguiente para que el resultado no se sienta como un numero, sino como una interpretacion personal y reconocible.
                </p>
            </div>

            <div class="journey-track" data-reveal>
                {% for step in journey_steps %}
                    <article class="journey-track__step">
                        <span class="journey-track__index">{{ step.index }}</span>
                        <div class="journey-track__body">
                            <h3>{{ step.title }}</h3>
                            <p>{{ step.text }}</p>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <aside class="journey-layout__side">
                {% for collaborator in collaborators %}
                    <article class="journey-note" data-reveal>
                        <p class="hero-card__eyebrow">{{ collaborator.eyebrow }}</p>
                        <h3>{{ collaborator.title }}</h3>
                        <p>{{ collaborator.text }}</p>
                    </article>
                {% endfor %}
            </aside>
        </div>
    </section>

    <section class="section-block section-block--accent home-section home-section--closing" data-deferred>
        <div class="container-xxl closing-layout">
            <article class="closing-copy" data-reveal>
                <span class="section-tag">Da el siguiente paso</span>
                <h2>Entra en una lectura de personalidad hecha para quedarse contigo.</h2>
                <p>
                    Puedes empezar el cuestionario, volver a tu espacio personal o profundizar en el enfoque que da forma a Disperson.
                </p>
                <a class="btn btn-primary site-btn" href="{{ path('app_quiz_start') }}">Empezar test</a>
            </article>

            <div class="closing-actions" data-reveal>
                {% for card in access_cards %}
                    <article class="closing-action">
                        <div class="closing-action__copy">
                            <span class="closing-action__index">{{ card.index }}</span>
                            <div>
                                <h3>{{ card.title }}</h3>
                                <p>{{ card.text }}</p>
                            </div>
                        </div>

                        <a class="btn btn-outline-primary site-btn site-btn--ghost" href="{{ card.href }}">{{ card.label }}</a>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
