{% extends 'base.html.twig' %}

{% block title %}Disperson | Contacto{% endblock %}
{% block body_class %}page-contact{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/pages/content.css') }}">
{% endblock %}

{% block content %}
    {% set contact_cards = [
        {
            title: 'Flujo real de la app',
            text: 'Accede a login, cuestionario y perfil final servidos por Symfony con persistencia real.',
            href: path('app_login'),
            label: 'Entrar'
        },
        {
            title: 'Cuestionario Big Five',
            text: 'Abre el test OCEAN conectado a la base de datos y recorre la experiencia completa.',
            href: path('app_quiz_start'),
            label: 'Abrir test'
        },
        {
            title: 'Gestion de contenido',
            text: 'Revisa preguntas y personajes desde el area admin para mantener vivo el banco del proyecto.',
            href: path('admin'),
            label: 'Abrir admin'
        }
    ] %}

    <section class="content-hero">
        <div class="container-xxl contact-stage">
            <div class="content-intro" data-reveal>
                <span class="section-tag">Contacto</span>
                <h1>Demo funcional, revision del producto y mantenimiento del contenido desde un mismo punto.</h1>
                <p class="lead-text">
                    Aqui puedes entrar al flujo real de Disperson, abrir el banco administrable del proyecto o escribir para
                    revisar su evolucion funcional y tecnica.
                </p>
            </div>

            <article class="content-card contact-spotlight" data-reveal>
                <div>
                    <p class="team-card__eyebrow">Canal principal</p>
                    <h2>mibanezp0709@gmail.com</h2>
                    <p>
                        El contacto central sirve tanto para revisar la experiencia como para hablar del cuestionario, del perfil final
                        o del mantenimiento del banco de preguntas y personajes.
                    </p>
                </div>

                <div class="contact-spotlight__meta">
                    <div>
                        <strong>Email</strong>
                        <span>Feedback y demos</span>
                    </div>
                    <div>
                        <strong>Admin</strong>
                        <span>Preguntas y personajes</span>
                    </div>
                    <div>
                        <strong>Stack</strong>
                        <span>Symfony + Twig + Doctrine</span>
                    </div>
                </div>

                <div class="hero-actions">
                    <a class="btn btn-primary site-btn" href="mailto:mibanezp0709@gmail.com">Escribir ahora</a>
                    <a class="btn btn-outline-primary site-btn site-btn--ghost" href="{{ path('app_quiz_start') }}">Abrir el test</a>
                </div>
            </article>
        </div>
    </section>

    <section class="section-block section-block--dense" data-deferred>
        <div class="container-xxl contact-board">
            <div class="contact-board__grid">
                {% for card in contact_cards %}
                    <article class="content-card contact-card" data-reveal>
                        <h2>{{ card.title }}</h2>
                        <p>{{ card.text }}</p>
                        <a class="btn btn-outline-primary site-btn site-btn--ghost" href="{{ card.href }}">{{ card.label }}</a>
                    </article>
                {% endfor %}
            </div>

            <article class="content-card contact-board__aside" data-reveal>
                <div>
                    <p class="team-card__eyebrow">Capa visual</p>
                    <h2>La parte emocional del proyecto tambien comunica marca.</h2>
                    <p>
                        El sistema de personajes no sustituye la base psicologica, pero si ayuda a que la experiencia se vea viva
                        y tenga una recompensa clara al final del recorrido.
                    </p>
                </div>

                <div class="contact-board__aside-thumbs">
                    <div class="contact-board__aside-thumb">
                        <img
                            src="{{ asset('resources/characters/7.jpg') }}"
                            alt="Visual del perfil"
                            width="260"
                            height="260"
                            loading="lazy"
                            decoding="async"
                        >
                    </div>
                    <div class="contact-board__aside-thumb">
                        <img
                            src="{{ asset('resources/characters/20.jpg') }}"
                            alt="Visual del perfil"
                            width="260"
                            height="260"
                            loading="lazy"
                            decoding="async"
                        >
                    </div>
                </div>
            </article>
        </div>
    </section>
{% endblock %}
