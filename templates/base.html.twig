<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mi Sitio Web{% endblock %}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.0/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <!-- Modo oscuro personalizado -->
    <link href="{{ asset('css/styles.css') }}" rel="stylesheet">
</head>
<body>
{% block navbar %}
    <!-- Barra de navegación -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top py-3">
        <div class="container-fluid">
            <a class="navbar-brand fs-3" href="/">Mi Sitio</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link fs-5" href="/about">Acerca de</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fs-5" href="/contact">Contacto</a>
                    </li>
                    {% if app.user %}
                        <li class="nav-item">
                            <a class="nav-link fs-5" href="{{ path('app_profile') }}">{{ app.user.username }}</a>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="nav-link fs-5" href="{{ path('app_login') }}">Login</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
{% endblock %}

<!-- Contenido principal -->
<div class="container-fluid custom-margin-top p-0">
    {% block content %}{% endblock %}
</div>

<!-- Footer -->
<footer class="text-center mt-5">
    <div class="text-center" style="background-color: rgba(0, 0, 0, 0.05); padding: 10px;">
        &copy; Marc Ibáñez. Todos los derechos reservados.
    </div>
</footer>

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>
