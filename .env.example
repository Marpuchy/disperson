APP_ENV=dev
APP_SECRET=change-me-in-production
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=sync://
VAR_DUMPER_SERVER=127.0.0.1:9912

# Production example with Supabase session pooler (recommended for Doctrine):
# In a local .env file, quotes are fine:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres?serverVersion=15&charset=utf8"
#
# In Render's dashboard, set the DATABASE_URL value without wrapping quotes and with a real password.
# If the password contains special characters like @ : / ? # [ ] %, URL-encode it first.
